# Development template for dev-ar-generator. Copy to .env and replace placeholders.
# Never copy a local CSV-mode template into production runtime configuration unchanged.

# Active shared AWS configuration (Bedrock, S3 Vectors and development export client)
AWS_ACCESS_KEY_ID_OS=YOUR_DEVELOPMENT_ACCESS_KEY
AWS_SECRET_ACCESS_KEY_OS=YOUR_DEVELOPMENT_SECRET_KEY
AWS_REGION=us-east-1
S3_VECTORS_BUCKET_NAME=YOUR_DEVELOPMENT_VECTOR_BUCKET
S3_VECTORS_INDEX_NAME=YOUR_DEVELOPMENT_VECTOR_INDEX

# Local data path; this avoids SQL Server/pyodbc in the active dev loader.
USE_CSV_DATA=true
# CSV_DATA_DIR=/absolute/path/to/prepared-csv-directory
# If CSV mode is disabled, configure the development MySQL source:
# MYSQL_DATABASE_URL=mysql+mysqlconnector://USER:PASSWORD@HOST:3306/DATABASE

# Optional ordinary S3 exports / ancillary tools
# BUCKET_NAME=YOUR_DEVELOPMENT_EXPORT_BUCKET
# KNOWLEDGE_BASE_ID=YOUR_KNOWLEDGE_BASE_ID
# DATA_SOURCE_ID=YOUR_DATA_SOURCE_ID
# SLACK_WEBHOOK_URL=YOUR_SLACK_WEBHOOK_URL

# SQL Server/Fabric settings are for the separate diagnostic/production paths.
# SERVER=YOUR_SERVER
# DATABASE=YOUR_DATABASE
# CLIENT_ID=YOUR_CLIENT_ID
# CLIENT_SECRET=YOUR_CLIENT_SECRET

# Retained Supabase reference pipeline; not the active report API.
# SUPABASE_URL=YOUR_SUPABASE_URL
# COLLECTION_NAME=YOUR_COLLECTION_NAME
