# Production-path placeholders for main-ar-generator. Not a deployed environment.
# Configure real values through the intended deployment process; never commit them.

# Explicit credentials used by active Bedrock and S3 Vectors clients
AWS_ACCESS_KEY_ID_OS=YOUR_AWS_ACCESS_KEY
AWS_SECRET_ACCESS_KEY_OS=YOUR_AWS_SECRET_KEY
AWS_REGION=us-east-1
S3_VECTORS_BUCKET_NAME=YOUR_VECTOR_BUCKET
S3_VECTORS_INDEX_NAME=YOUR_VECTOR_INDEX

# Active SQL Server/Fabric source (pyodbc and ODBC Driver 18 remain required)
SERVER=YOUR_SQL_SERVER
DATABASE=YOUR_DATABASE
CLIENT_ID=YOUR_SERVICE_PRINCIPAL_ID
CLIENT_SECRET=YOUR_SERVICE_PRINCIPAL_SECRET
USE_CSV_DATA=false

# Ordinary S3 exports use boto3's standard credential chain, not the custom OS keys.
BUCKET_NAME=YOUR_EXPORT_BUCKET

# Scheduled KB sync and optional Slack notifications
KNOWLEDGE_BASE_ID=YOUR_KNOWLEDGE_BASE_ID
DATA_SOURCE_ID=YOUR_DATA_SOURCE_ID
# SLACK_WEBHOOK_URL=YOUR_SLACK_WEBHOOK_URL

# Optional prepared-CSV override for load_data only; it does not remove pyodbc
# imports and does not switch load_full_data to CSV.
# CSV_DATA_DIR=/absolute/path/to/prepared-csv-directory
