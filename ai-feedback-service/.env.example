# AI Interaction Tracking service: local example, not deployed configuration.
# Copy to .env; never commit credentials. Branch names do not select ENV.
AWS_REGION=us-east-1

# Required literal table suffix: ai-requests-{ENV}. Select the intended
# environment before starting; import may create this table if it is absent.
# For deployment, explicitly supply the intended environment and AWS identity.
ENV=testing

# Active DynamoDB clients use the SDK credential chain (role/profile/env).
# Optional local environment credentials; use a session token when required:
# AWS_ACCESS_KEY_ID=replace_with_access_key
# AWS_SECRET_ACCESS_KEY=replace_with_secret_key
# AWS_SESSION_TOKEN=replace_with_session_token_if_required

# Optional best-effort negative-feedback notifications. Empty URL means no
# successful broker connection; configure all fields before using notifications.
RABBITMQ_URL=
EMAIL_QUEUE_NAME=replace_with_email_queue
EMAIL_SENDER=sender@example.invalid
EMAIL_SENDER_NAME=Example Sender
EMAIL_RECIPIENT=reviewer@example.invalid
MS_AUTH_USER=replace_with_email_service_user
MS_AUTH_PASSWORD=replace_with_email_service_password

# BUCKET_NAME belongs to legacy S3 code, not the active DynamoDB path.
