# =============================================================================
# CLARISA - CGSpace Mapping - Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in your real credentials
# NEVER upload the .env file to the repository

# =============================================================================
# CLARISA API
# =============================================================================
CLARISA_API_URL = clarisa-api-url
CLARISA_PARTNER_REQUESTS_URL = clarisa-partner-requests-url
CLARISA_CREATE_URL = clarisa-create-url
CLARISA_RESPOND_URL = clarisa-respond-url
CLARISA_COUNTRIES_URL = clarisa-countries-url
CLARISA_INSTITUTION_TYPES_URL = clarisa-institution-types-url

# =============================================================================
# Supabase
# =============================================================================
# Obtain these credentials from: Settings > API in your Supabase project
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-or-service-role-key

# =============================================================================
# AWS Bedrock (Embeddings & Web Search Analysis)
# =============================================================================
# Used for:
# 1. Embeddings with Amazon Titan (semantic search in CLARISA)
# 2. Web results analysis with Claude Sonnet 4.5 (Phase 2 of web search)
# Make sure you have access to us-east-1 and the necessary models:
#   - amazon.titan-embed-text-v2:0 (embeddings)
#   - us.anthropic.claude-sonnet-4-5-20250929-v1:0 (analysis)
AWS_ACCESS_KEY_ID_BR=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY_BR=your-aws-secret-access-key
AWS_REGION=us-east-1

S3_TEMPLATE_BUCKET=your-s3-bucket-name
S3_TEMPLATE_KEY=your-s3-template-key.xlsx

# =============================================================================
# OpenAI (Web Search Phase 1: Information Gathering)
# =============================================================================
# Obtain your API key from: https://platform.openai.com/api-keys
# Used for exploratory web search (Phase 1) when no match is found in CLARISA
# The gpt-5-mini model gathers information that is then analyzed by Claude in Phase 2
OPENAI_API_KEY=your-openai-api-key

# =============================================================================
# Automated Partner Request Flow (/api/auto-partner-request)
# =============================================================================
# Optional Bedrock model overrides — safe to leave unset (defaults shown apply)
# Small/fast model used only for the Very Good/Good "same institution?" duplicate check
BEDROCK_DUPLICATE_CHECK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
# Larger model used for the CGIAR business-rules validation (Fair/No match/fallthrough)
BEDROCK_RULES_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# Shared email microservice (RabbitMQ)
RABBITMQ_URL=url_to_shared_rabbitmq_instance
EMAIL_QUEUE_NAME=queue_name_here
EMAIL_SENDER=sender@example.com
EMAIL_SENDER_NAME=Partner Request Support
MS_AUTH_USER=your_auth_user_here
MS_AUTH_PASSWORD=your_auth_password_here
# Recipient for internal "pending manual review" notices
PRMS_ADMIN_NOTIFICATION_EMAIL=