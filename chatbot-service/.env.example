# AICCRA Chatbot service-main: copy to .env; never commit credentials.
AWS_REGION=us-east-1
AGENT_ID=replace_with_agent_id
AGENT_ALIAS_ID=replace_with_alias_id
KNOWLEDGE_BASE_ID=replace_with_knowledge_base_id

# AWS clients use the SDK credential chain. Prefer a deployment role or
# configured local profile. Only if using environment credentials locally:
# AWS_ACCESS_KEY_ID=replace_with_access_key
# AWS_SECRET_ACCESS_KEY=replace_with_secret_key
# AWS_SESSION_TOKEN=replace_with_session_token_if_required

# Optional retained S3 helpers; not required for normal chat.
# BUCKET_NAME=replace_with_bucket_name

# HTML chat/feedback URLs are JavaScript constants, not environment settings.
# memory_id comes from the request. SQL/OpenSearch/Streamlit/OpenAI development
# implementations are not included in this branch.
