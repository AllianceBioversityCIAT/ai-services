# AICCRA Chatbot: copy to .env; never commit credentials.
# Active Bedrock Agent path reads these exact names (no _BR/_OS variants).
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=replace_with_access_key
AWS_SECRET_ACCESS_KEY=replace_with_secret_key
AGENT_ID=replace_with_agent_id
AGENT_ALIAS_ID=replace_with_alias_id
KNOWLEDGE_BASE_ID=replace_with_knowledge_base_id

# Streamlit interaction/feedback API; HTML uses its own fixed constant.
AI_FEEDBACK_URL=https://feedback.example.invalid

# Auxiliary S3 exports / direct OpenSearch / SQL extraction, not normal chat.
BUCKET_NAME=replace_with_bucket_name
OPENSEARCH_HOST=replace_with_opensearch_host
OPENSEARCH_INDEX_NAME_CHATBOT=replace_with_index_name
SERVER=replace_with_sql_server
DATABASE=replace_with_database
CLIENT_ID=replace_with_client_id
CLIENT_SECRET=replace_with_client_secret

# Read into config, but active chat receives memory_id from the caller.
MEMORY_ID=demo-user

# Independent openai_chatbot.py experiment only.
OPENAI_API_KEY=replace_with_openai_key
VECTOR_STORE_ID=replace_with_vector_store_id
